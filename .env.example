# ── GuestSnap environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. EVERY integration has a working mock:
# leave a key blank and the app runs in mock mode for that provider.
# Rotation: rotate any leaked key at the provider dashboard, update here,
# redeploy. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign mock sessions, media tokens and cron calls in dev.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
APP_SECRET=dev-only-change-me-32-byte-hex-secret-string

# Supabase (blank → in-memory data store persisted to .data/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Stripe (blank → mock checkout page that simulates payment locally)
STRIPE_SECRET_KEY=sk_test_51dummy_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51dummy_publishable_key

# Resend (blank → emails logged to .data/emails/ and console)
RESEND_API_KEY=re_dummy_resend_api_key_123456
EMAIL_FROM=GuestSnap <hello@guestsnap.app>

# PostHog (blank → analytics no-op, events logged in dev console)
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy_posthog_client_key_123456
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (blank → errors logged to console only)
SENTRY_DSN=https://dummy_public_key@o0.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=https://dummy_public_key@o0.ingest.sentry.io/0000000

# Sightengine NSFW screening (blank → mock moderator; flags nothing)
SIGHTENGINE_USER=dummy_sightengine_user
SIGHTENGINE_SECRET=dummy_sightengine_secret

# Cloudflare Turnstile (blank → captcha check skipped in mock mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAdummy_turnstile_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAAdummy_turnstile_secret_key

# Cron protection — Vercel sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=dummy_cron_secret_key_123456

# Admin page allowlist (comma-separated emails)
ADMIN_EMAILS=admin@example.com,ops@example.com
